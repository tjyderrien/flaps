\begin_layout Section
Validation of lattice thermal coupling
\end_layout

\begin_layout Subsection
Heating of the lattice by hot electrons
\end_layout

\begin_layout Paragraph
Reduction to a 
\begin_inset Quotes eld
\end_inset

simple
\begin_inset Quotes erd
\end_inset

 case
\end_layout

\begin_layout Standard
This section investigates the heating of the lattice in our conditions.
 Eq.
 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:TTMlattice"

\end_inset

 is reduced to its simplest form allowing to validate to calculate the heating
 of the lattice.
 The laser source is disabled, and we only consider the coupling between
 a gas of hot electrons at a fixed density coupled with the lattice.
 This allows to set the carrier density 
\begin_inset Formula $n_{e}$
\end_inset

 as a constant, and the free-carrier temperature 
\begin_inset Formula $T_{e}$
\end_inset

 as a constant.
 Thus, the carrier heat capacity 
\begin_inset Formula $C_{e}$
\end_inset

, and the electron-lattice coupling rate 
\begin_inset Formula $\gamma_{e-ph}$
\end_inset

 are constant.
 These approximations lead to set the following equation 
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{\partial\left[C_{s}(T_{s}(t))\times T_{s}(t)\right]}{\partial t}=\gamma_{e-ph}\left[T_{e}^{0}-T_{s}(t)\right]\label{eq:TTMlattice-1}
\end{equation}

\end_inset

where 
\begin_inset Formula 
\begin{equation}
\gamma_{e,h-ph}=C_{e,h}\nu_{e,h-ph}.\label{eq:Coupling-1-1}
\end{equation}

\end_inset


\begin_inset Formula 
\[
\nu_{e,ph}^{-1}=\tau_{ph}^{0}\left[1+\left(\frac{n_{e}^{0}}{n_{th}}\right)^{2}\right].
\]

\end_inset

In our case, the lattice heat capacity strongly depends to the lattice temperatu
re 
\begin_inset Formula $T_{s}$
\end_inset

.
 Depending on the form of the coefficient 
\begin_inset Formula $C_{s}\left(T_{s}\right)$
\end_inset

, Eq.
 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:TTMlattice-1"

\end_inset

 will therefore exhibit strong non-linearities.
 Before considering solving this equation, we first develop the possible
 functions used to adjust the lattice heat capacity on the available experimenta
l results.
 In all the cases, the equation is non-linear and does not admit a simple
 analytical solution.
 We are thus able to compare the quality of the numerical integration with
 other numerical integration packages and keep checking the energy conservation
 of our results.
 However, no error estimation will be possible to perform since no analytical
 solution is available.
 
\end_layout

\begin_layout Paragraph
Adjustment of the lattice heat capacity
\end_layout

\begin_layout Standard
Here is a list of the functions which have been built as a function of lattice
 temperature fitting the experimental measurements of Refs.
 
\begin_inset CommandInset citation
LatexCommand cite
key "Flubacher1959,Okhotin1972"

\end_inset

.
 Each case will lead to different types of non-linearities.
 Since we have different possibilities to adjust the experimental data,
 the type of function should be chosen in order to minimizer the difficulties
 over the numerical integration.
 
\end_layout

\begin_layout Enumerate
Exponent fraction
\begin_inset Formula 
\[
C_{s}(T_{s})=\frac{a_{0}}{e^{a_{1}/T_{s}}-a_{2}}=\frac{0.4129\times10^{3}\rho_{Si}}{e^{\frac{88.183}{T_{s}}}-0.6765}
\]

\end_inset

The resulting type of the equation is 
\begin_inset Formula 
\[
a_{0}a_{1}\left(\frac{\partial{\it T_{s}}}{\partial t}\right){\rm e}^{\frac{a_{1}}{{\it T_{s}}\left(t\right)}}\left({\rm e}^{\frac{a_{1}}{{\it T_{s}}\left(t\right)}}-a_{2}\right)^{-2}\left({\it T_{s}}\left(t\right)\right)^{-1}+a_{0}\frac{\partial T_{s}}{\partial t}\left({\rm e}^{\frac{a_{1}}{T_{s}\left(t\right)}}-a_{2}\right)^{-1}=\frac{{\it C_{e}}\left({\it T_{e}^{0}}-{\it T_{s}}\left(t\right)\right)}{{\it \tau_{e}}}
\]

\end_inset


\end_layout

\begin_layout Enumerate
Sum of exponents
\begin_inset Formula 
\[
C_{s}(T_{s})=\eta\left(ae^{bT_{s}}+ce^{dT_{s}}\right)
\]

\end_inset

where 
\begin_inset Formula $\eta=10^{3}\rho_{Si}$
\end_inset

, 
\begin_inset Formula $a=0.899$
\end_inset

, 
\begin_inset Formula $b=5.455\times10^{-5}$
\end_inset

, 
\begin_inset Formula $c=-0.959$
\end_inset

, and 
\begin_inset Formula $d=-0.004218$
\end_inset

.
 The resulting type of equation is 
\begin_inset Formula 
\[
\left(\frac{\partial{\it T_{s}}}{\partial t}\right)\eta\left({\it T_{s}}\left(t\right)abe^{b\times{\it T_{s}}\left(t\right)}+{\it T_{s}}\left(t\right)cd{e}^{d\times{\it T_{s}}\left(t\right)}+ae^{b\times{\it T_{s}}\left(t\right)}+ce^{d\times{\it T_{s}}\left(t\right)}\right)=\frac{{\it C_{e}}\left(-{\it T_{e}^{0}}+{\it T_{s}}\left(t\right)\right)}{\tau_{e}}
\]

\end_inset


\end_layout

\begin_layout Enumerate
Real-valued polynomial
\begin_inset Formula 
\[
C_{s}\left(T_{s}\right)=\sum_{i=0}^{i=5}a_{i}T_{s}^{i}
\]

\end_inset

 where 
\begin_inset Formula $a_{5}$
\end_inset

 = 
\begin_inset Formula $2.36\times10^{-16}$
\end_inset

, 
\begin_inset Formula $a_{4}=-1.707\times10^{-12}$
\end_inset

, 
\begin_inset Formula $a_{3}=4.619\times10^{-9}$
\end_inset

, 
\begin_inset Formula $a_{2}=-5.912\times10^{-6}$
\end_inset

, 
\begin_inset Formula $a_{1}=3.733\times10^{-3}$
\end_inset

, and 
\begin_inset Formula $a_{0}=-0.0494$
\end_inset

.
 The resulting of equation is 
\begin_inset Formula 
\[
\left(\frac{\partial T_{s}}{\partial t}\right)\left(2a_{1}{\it T_{s}}\left(t\right)+3a_{2}\left({\it T_{s}}\left(t\right)\right)^{2}+4a_{3}\left({\it T_{s}}\left(t\right)\right)^{3}+5a_{4}\left({\it T_{s}}\left(t\right)\right)^{4}+6a_{5}\left({\it T_{s}}\left(t\right)\right)^{5}+a_{0}\right)=\frac{{\it C_{e}}\left(-{\it T_{e}^{0}}+{\it T_{s}}\left(t\right)\right)}{\tau_{e}}
\]

\end_inset


\end_layout

\begin_layout Enumerate
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
Sum of sinus
\begin_inset Formula 
\[
C_{s}\left(T_{s}\right)=\sum_{i=1}^{4}a_{i}\sin\left(b_{i}T_{s}+c_{i}\right)
\]

\end_inset

leads to the following type of ODE
\begin_inset Formula 
\[
\left(\frac{\partial T_{s}}{\partial t}\right)\left[\left(1+T_{s}(t)\right)\cos\left(T_{s}\right)\right]=\frac{{\it C_{e}}\,\left(-{\it T_{e}^{0}}+{\it T_{s}}\left(t\right)\right)}{\tau_{e}}
\]

\end_inset

and is very unstable.
 
\end_layout

\end_inset

Van Driel's style fit function
\begin_inset Formula 
\[
C_{s}\left(T_{s}\right)=10^{3}\rho_{Si}\times\left(a_{0}T_{s}+a_{1}T_{s}^{a_{2}}\right)
\]

\end_inset

with 
\begin_inset Formula $a_{0}=-0.003592$
\end_inset

, 
\begin_inset Formula $a_{1}=0.01458$
\end_inset

, and 
\begin_inset Formula $a_{2}=0.8316$
\end_inset

.
 The stability of this function is very good.
 However, the temperature validity range of this function is limited to
 1400 K.
 
\end_layout

