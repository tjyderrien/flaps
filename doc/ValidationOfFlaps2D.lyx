\begin_layout Subsection
Auger recombination
\end_layout

\begin_layout Standard
The formulation proposed by 
\begin_inset CommandInset citation
LatexCommand cite
key "Silaeva2012a"

\end_inset

 has to be validated within several steps.
 Auger recombination is modeled by a coupled non-linear system.
 In that section, we only consider the equation of free-carrier given by
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{\partial n_{e}}{\partial t}=\frac{\partial n_{h}}{\partial t}=C_{h}^{AR}n_{h}^{2}n_{e}+C_{e}^{AR}n_{e}^{2}n_{h}\label{eq:AugerNe}
\end{equation}

\end_inset

Analytical solution of the equation is given by 
\begin_inset Formula 
\[
n_{e}(t)=\frac{C_{AR}^{(h)}n_{e}^{0}n_{h}^{0}}{\left(n_{e}^{0}C_{AR}^{(e)}+n_{h}^{0}C_{AR}^{(h)}\right)\exp\left(C_{AR}^{(h)}n_{h}^{2}t\right)-C_{AR}^{(e)}n_{e}^{0}}
\]

\end_inset


\end_layout

