		plot(ps="2D-Epsilon"+iterations+".eps", DielectricRe, fill=1, cmm="EpsilonRe, t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, nbiso=30);
		plot(ps="2D-Strain"+iterations+".eps", printer7, fill=true, cmm="Strain [N/m], t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, nbiso=30); 
		plot(ps="2D-Enthalpy"+iterations+".eps", Enthalpy, fill=true, cmm="Enthalpy [J/m3], t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, nbiso=30); 
		plot(ps="2D-logEnthalpy"+iterations+".eps", printer8, fill=true, cmm="log(Enthalpy [N/m]), t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, nbiso=30); 
