		printer12=phi; printer15=Ex; printer16=Ey; 
	}
	if(ActivatePoisson>1) { 
		printer12=real(phiC); 
		ExC=dx(phiC); EyC=dy(phiC); 
		printer15=real(ExC); printer16=real(EyC); 
		printer20=real(sqrt(ExC*conj(ExC)+EyC*conj(EyC)));
	}
	printer17=log10(abs(printer15)); printer18=log10(abs(printer16)); 

