		plot(ps="2D-logNe"+iterations+".eps", printer4, fill=1, cmm="log10(Ne), t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, nbiso=30);
		plot(ps="2D-ZoomedLogNe"+iterations+".eps", printer4, fill=1, cmm="Ne, t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, nbiso=30, bb=[[-5e-6,0], [5e-6,500e-9]]);
 		plot(ps="2D-Nh"+iterations+".eps", Nh, fill=1, cmm="Nh, t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, nbiso=30);
		plot(ps="2D-ZoomedNh"+iterations+".eps", Nh, fill=1, cmm="Nh, t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, nbiso=30, bb=[[-5e-6,0], [5e-6,500e-9]]);
		plot(ps="2D-Potential"+iterations+".eps", printer12, ThNeedle, fill=1, cmm="Potential, t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, viso=isoPotential); //nbiso=30
  		plot(ps="2D-Ex"+iterations+".eps", printer15, fill=1, cmm="abs(Ex), t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, viso=isoField);
		plot(ps="2D-InducedFieldNorm"+iterations+".eps", printer20, ThNeedle, fill=1, cmm="abs(Einduced), t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, viso=isoField);
