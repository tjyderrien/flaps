		plot(ps="2D-logIntensity"+iterations+".eps", printer, fill=1, cmm="Intensity, t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, nbiso=30);
		plot(ps="2D-ZoomedIntensity"+iterations+".eps", Intensity, fill=1, cmm="Intensity, t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, nbiso=30, bb=[[-5e-6,0], [5e-6,500e-9]]);
		plot(ps="2D-ZoomedlogIntensity"+iterations+".eps", printer, fill=1, cmm="Intensity, t="+t*1E12+" ps, dt="+1e15*dt+"fs", value=true, aspectratio=false, nbiso=30, bb=[[-5e-6,0], [5e-6,500e-9]]);
